# Copy to .env and set your MongoDB Atlas connection string locally.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=cuahang
PORT=3000
# Optional; if unset, a secret is generated and stored in MongoDB.
JWT_SECRET=
# Required only for Admin self-service password recovery. Use a long random secret.
ADMIN_RECOVERY_CODE=

# Only used by the MySQL-to-MongoDB migration script.
# SOURCE_DATABASE_URL=mysql://<user>:<password>@127.0.0.1:3306/cuahang
# SOURCE_DB_SSL=0
